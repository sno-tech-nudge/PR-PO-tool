# Copy to .env.local for local work, and set the same names in the host's environment variables (Vercel: Project Settings,
# Environment Variables). Never commit real values. The full list, and what each is for, is in docs/INTEGRATIONS_AND_API.md
# and scripts/migration/inventory.json (`npm run migration:check` keeps them in step with the code).

# ---- Browser build (public by design: the anon key is protected only by database policies) ----
# The Supabase project the app talks to. Also read by the daily reminder job on the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (no VITE_ prefix, deliberately, so they are never bundled into browser code) ----
# AI: Gemini reads images and PDFs (OCR), Groq writes summaries and checks. Both are called from api/ai/proxy.js.
GEMINI_API_KEY=
GROQ_API_KEY=

# Email through Resend (api/send-email.js). RESEND_FROM_EMAIL must use a domain verified in the Resend account, e.g. "The Nudge <noreply@your-domain>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Slack incoming-webhook URL for PR, PO and vendor events and the daily reminders (api/notify-slack.js, api/reminders.js). Optional: unset = no Slack.
SLACK_WEBHOOK_URL=

# Protects /api/reminders. Vercel Cron sends it as "Authorization: Bearer <value>" automatically. If unset the route is open to anyone.
CRON_SECRET=

# ---- Local scripts only (scripts/migration/*). A direct Postgres connection string, never needed by the deployed app. ----
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
