VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Server-side only (no VITE_ prefix — read by api/send-vendor-email.js,
# never bundled into the browser build). Set these in Vercel's Environment
# Variables, not just locally, for vendor approve/reject emails to send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-side only. Shared secret the api/intake/* routes require on every
# request (Authorization: Bearer <this value>) — the only caller is meant to
# be Nucleus's "intake-proxy" edge function, which holds the matching value
# as its own PR_PO_INTAKE_SECRET. Set the same random value here and there.
PR_PO_INTAKE_SECRET=
